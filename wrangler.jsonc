{
	"main": "dist/_worker.js/index.js",
	"name": "codeclub",
  "compatibility_date": "2026-02-22",
  "compatibility_flags": [
    "nodejs_compat",
    "global_fetch_strictly_public"
  ],
	"assets": {
		"binding": "ASSETS",
		"directory": "./dist"
	},
	"observability": {
    "enabled": true
  },
  "vars": {
    "DISCORD_CALLBACK_URL": "http://localhost:4321/api/auth/callback"
  },
  "env": {
    "production": {
      "name": "codeclub",
      "vars": {
        "DISCORD_CALLBACK_URL": "https://codeclub.avayashrestha.workers.dev/api/auth/callback"
      }
    }
  }
}
